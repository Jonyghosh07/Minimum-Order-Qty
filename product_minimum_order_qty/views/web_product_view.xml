<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="product_quantity_min" inherit_id="website_sale.product_quantity" name="Select Quantity">
        <xpath expr="//input[@name='add_qty']" position="replace">
            <!--Customer will not be able to order less than products minium order qty-->
            <t t-if="product.minimum_order_quantity">
                <input type="text" class="form-control quantity text-center" t-att-data-min="product.minimum_order_quantity" name="add_qty" t-att-value="product.minimum_order_quantity" readonly="readonly"/>
            </t>
            <t t-else="">
                <input type="text" class="form-control quantity text-center" data-min="1" name="add_qty" t-att-value="add_qty or 1"/>
            </t>
        </xpath>
    </template>

    <template id="product_cart_lines" inherit_id="website_sale.cart_lines" name="Quantity">
        <xpath expr="//input[hasclass('js_quantity')]" position="replace">
            <input type="text" class="js_quantity quantity form-control border-start-0 border-end-0"
            t-att-data-line-id="line.id"
            t-att-data-product-id="line.product_id.id"
            t-att-data-min="line.product_id.minimum_order_quantity"
            readonly="readonly"
            t-att-value="line._get_displayed_quantity()"/>
        </xpath>
    </template>
</odoo>